#!/usr/bin/env bash
# bl — Blender-CLI fuer Agenten (headless, ohne MCP). Laeuft mit dem Python von Blender 5.2.4 (numpy, PIL).
# Hilfe: bl --help · Doku im Wiki: Blender/Plans/bl Phase 1 — Kern (Plan)
here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
bdir="${BL_BLENDER_DIR:-/mnt/caches/ComfyUI/_tools/blender-5.2.4-linux-x64}"
py="$(ls "$bdir"/*/python/bin/python3.* 2>/dev/null | head -1)"
[ -x "$py" ] || { echo "✗ Blender-Python nicht gefunden unter $bdir" >&2; exit 3; }
exec env -u LD_LIBRARY_PATH -u PYTHONPATH -u PYTHONHOME PYTHONDONTWRITEBYTECODE=1 \
  BL_REPO="$here" BL_BLENDER_DIR="$bdir" "$py" -s "$here/bl/cli.py" "$@"
